# Flipper Zero Transport Configuration
FLIPPER_TRANSPORT=usb              # Transport type: auto, usb, or wifi
FLIPPER_PORT=                      # USB serial port (auto-detected if empty)
FLIPPER_WIFI_HOST=                 # WiFi devboard IP address (e.g., 192.168.1.100)
FLIPPER_WIFI_PORT=8080             # WiFi devboard port number

# ESP32 Marauder (UART Bridge)
MARAUDER_PORT=                     # ESP32 Marauder serial port (auto-detected if empty)

# Flipper MCP Server
FLIPPER_MCP_ALLOW_STUB_MODE=false  # Allow stub mode (no hardware) for testing/dev
FLIPPER_AUDIT_LOG=                 # Audit JSONL log file path (optional)

# OSINT & Reconnaissance
SHODAN_API_KEY=                    # Shodan API key for internet device search

# Ralph Loop (Autonomous Pentest)
SCOPE=all devices in range         # Target scope description
HITL=false                         # Human-in-the-loop gate for exploit phase (true/false)

# OpenCode/Claude Code Configuration
OPENCODE_DISABLE_CLAUDE_CODE=0     # Disable Claude Code integration (0 or 1)

# Optional: Bleak (BLE) Configuration
BLEAK_LOGGING=false                # Enable Bleak debug logging (true/false)
BLEAK_DBUS_AUTH_UID=               # D-Bus authentication UID (Linux only, optional)
